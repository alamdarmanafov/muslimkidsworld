# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API). NEXT_PUBLIC_* vars are bundled into the
# browser, so only put the anon/public key here — never the service_role key.
# Same project mobile/.env and admin/index.html's setup screen point at.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
