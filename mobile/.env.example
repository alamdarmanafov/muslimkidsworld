# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API). EXPO_PUBLIC_* vars are bundled into the client,
# so only put the anon/public key here — never the service_role key.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# iOS OAuth client ID from Google Cloud Console (Sign in with Google) — see
# supabase/README.md. Client IDs are not secret; safe to bundle into the app.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-id.apps.googleusercontent.com
